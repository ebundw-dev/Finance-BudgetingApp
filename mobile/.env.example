# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see .gitignore's `.env*.local` pattern) --
# never commit real tokens.
#
# Both vars are inlined into the JS bundle at build time via Expo's
# EXPO_PUBLIC_ prefix convention. They only pre-fill the test screen's
# two input fields -- you can also just type them in by hand at runtime.

# Base URL of the Ledger web app, reachable from your phone. During
# local development this is usually an ngrok tunnel URL pointing at
# `npm run dev` (see mobile/README.md), e.g.:
# EXPO_PUBLIC_API_BASE_URL=https://abcd-1234.ngrok-free.app
EXPO_PUBLIC_API_BASE_URL=

# A token issued by the Phase 1 API (via the web app's /settings page,
# or POST /api/auth/token). Treat it like a password.
EXPO_PUBLIC_API_TOKEN=
